{
  "manifest_version": 3,
  "name": "CG Meet Hub - Class Schedule Dashboard",
  "version": "1.0.0",
  "description": "Injects a native Google Material Design class schedule dashboard directly into Google Meet homepage.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://meet.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CG Meet Hub"
  }
}
